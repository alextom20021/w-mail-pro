# Copy to .env and fill in real values. NEVER commit the real .env file
# (it's already in .gitignore).

APP_URL=https://app.example.com
APP_ENCRYPTION_KEY=   # generate with: php -r "require 'vendor/autoload.php'; echo MailAI\Security\EncryptionService::generateKey();"

DB_HOST=mysql
DB_PORT=3306
DB_NAME=mailai
DB_USER=mailai
DB_PASS=change_me

# Platform-level AI provider keys are stored encrypted in the ai_providers
# table (see database/001_platform_schema.sql), NOT here — this avoids a
# plaintext key sitting in a .env file on the app server. Use a one-time
# seed script to insert them encrypted. These env vars are only a
# bootstrap fallback for local dev before the ai_providers table is seeded.
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=

REDIS_HOST=redis
REDIS_PORT=6379
